{
  "name": "crumble",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*.ts",
    "#db/*": "./src/db/*.ts",
    "#*/extension": "./src/*/extension.ts",
    "#*": "./src/*/*.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "service": "bun src/main.ts",
    "auth": "bun --no-env-file scripts/auth.ts",
    "doctor": "bun scripts/doctor.ts",
    "spike": "bun --no-env-file scripts/spike.ts",
    "check": "tsc --noEmit",
    "test": "bun --no-env-file test test/",
    "sandbox:build": "docker build -t crumble-sandbox -f docker/Dockerfile.sandbox docker",
    "browser:build": "docker build -t crumble-browser -f docker/Dockerfile.browser docker",
    "db:generate": "drizzle-kit generate --config=drizzle.assistant.config.ts && drizzle-kit generate --config=drizzle.jobs.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.assistant.config.ts && drizzle-kit check --config=drizzle.jobs.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "cron-parser": "5.10.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "1.0.0-rc.4",
    "execa": "10.0.1",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2"
  }
}
